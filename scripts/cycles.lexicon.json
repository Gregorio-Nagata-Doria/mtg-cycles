{
  "_meta": {
    "purpose": "Canonical PT/EN base-name per cycle theme token. Used by the naming pipeline to keep names consistent across sets.",
    "schema": "themeToken -> { en, pt, review? }. en/pt are the canonical PLURAL cycle name. review:true = PT/name is a guess; every cycle using this base is flagged review:true.",
    "policy": "EN uses the community cycle name. PT translates when a consolidated PT term exists; otherwise keeps the English term (Leylines, Gearhulks, Myojin, Zubera, Baku, Genju, Charms). Set suffix is applied by the pipeline, not stored here."
  },

